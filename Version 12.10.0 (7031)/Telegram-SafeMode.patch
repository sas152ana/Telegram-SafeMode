+private void feedJumpToSearchResult(long channelDid, int mid, boolean select) {
+    if (mid == 0) {
+        return;
+    }
+    java.util.ArrayList<MessageObject> found = getMediaDataController().searchResultMessages;
+    if (found != null) {
+
+        for (int pass = 0; pass < 2; pass++) {
+            for (int i = 0; i < found.size(); i++) {
+                MessageObject m = found.get(i);
+                if (m == null || m.messageOwner == null || m.getId() != mid) {
+                    continue;
+                }
+                long cid = feedChannelId(m);
+                if (pass == 0 && cid != channelDid) {
+                    continue;
+                }
+                feedJumpToMessage(cid, mid, m.messageOwner.date, select);
+                return;
+            }
+        }
+    }
+    for (int i = 0; i < messages.size(); i++) {
+        MessageObject m = messages.get(i);
+        if (m != null && m.messageOwner != null && m.getId() == mid) {
