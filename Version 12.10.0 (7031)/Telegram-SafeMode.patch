+
+    public static long getFeedIdForFolder(int folderId) {
+        return VIRTUAL_FEED_ALL_ID - folderId;
+    }
+
+    public boolean isFeedHidden(int folderId) {
+        return prefs.getBoolean("feed_hidden_" + folderId, true);
+    }
+
+    public void setFeedHidden(int folderId, boolean hide) {
+        prefs.edit().putBoolean("feed_hidden_" + folderId, hide).apply();
+        applySafeModeState();
+    }
+
+    // Safemode;
+    public boolean isFeedOnlyInSecret() {
+        return prefs.getBoolean("feed_only_in_secret", false);
