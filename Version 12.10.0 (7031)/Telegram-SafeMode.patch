+private int feedDatePosition(int date) {
+    int found = -1;
+    for (int i = 0; i < messages.size(); i++) {
+        MessageObject m = messages.get(i);
+        if (m == null || m.messageOwner == null || m.getId() == 0) {
+            continue;
+        }
+        if (m.messageOwner.date >= date) {
+            found = i;
+        } else {
+            break;
+        }
+    }
+    return found;
+}
+
+private boolean feedWindowCoversDate(int date) {
+    MessageObject newest = null;
+    MessageObject oldest = null;
+    for (int i = 0; i < messages.size(); i++) {
+        MessageObject m = messages.get(i);
+        if (m == null || m.messageOwner == null || m.getId() == 0) {
+            continue;
+        }
+        if (newest == null) {
+            newest = m;
+        }
+        oldest = m;
+    }
+    return newest != null
+            && newest.messageOwner.date >= date
+            && oldest.messageOwner.date <= date;
+}
+
+private String feedMessageKey(MessageObject m) {
+    if (m == null || m.messageOwner == null) {
+        return null;
+    }
+    long cid = (m.messageOwner.peer_id != null)
+            ? org.telegram.messenger.DialogObject.getPeerDialogId(m.messageOwner.peer_id)
+            : m.getFromChatId();
+    return cid + ":" + m.getId();
+}
+
+private long feedChannelId(MessageObject m) {
+    if (m == null || m.messageOwner == null) {
+        return 0L;
+    }
+    return (m.messageOwner.peer_id != null)
+            ? org.telegram.messenger.DialogObject.getPeerDialogId(m.messageOwner.peer_id)
+            : m.getFromChatId();
+}
+
+private boolean feedIsOlder(MessageObject a, MessageObject b) {
+    int da = (a.messageOwner != null) ? a.messageOwner.date : 0;
+    int db = (b.messageOwner != null) ? b.messageOwner.date : 0;
+    if (da != db) {
+        return da < db;
+    }
+    long ua = feedChannelId(a);
+    long ub = feedChannelId(b);
+    if (ua != ub) {
+        return ua < ub;
+    }
+    return a.getId() < b.getId();
+}
+
+private int feedInsertPosition(MessageObject m) {
+    for (int i = 0; i < messages.size(); i++) {
+        if (feedIsOlder(messages.get(i), m)) {
+            return i;
+        }
+    }
+    return messages.size();
+}
