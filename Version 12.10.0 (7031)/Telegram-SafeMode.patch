+private void feedFlushReadSync() {
+    if (!org.telegram.messenger.SecretModeController.isVirtualFeed(dialog_id) || feedReadNewestSeen.isEmpty()) {
+        return;
+    }
+    for (java.util.Map.Entry<Long, MessageObject> entry : feedReadNewestSeen.entrySet()) {
+        long sourceDid = entry.getKey();
+        MessageObject msg = entry.getValue();
+        if (msg == null || msg.messageOwner == null) {
+            continue;
+        }
+        TLRPC.Dialog d = getMessagesController().dialogs_dict.get(sourceDid);
+        if (d == null) {
+            continue;
+        }
+        int maxMid = msg.getId();
+
+        int prevReadMaxId = feedReadMaxId(sourceDid);
+        if (maxMid <= prevReadMaxId) {
+            continue;
+        }
+
+        int countDiff = 0;
+        for (int i = 0; i < messages.size(); i++) {
+            MessageObject seen = messages.get(i);
+            if (seen == null || seen.messageOwner == null || seen.messageOwner.peer_id == null) {
+                continue;
+            }
+            if (org.telegram.messenger.DialogObject.getPeerDialogId(seen.messageOwner.peer_id) != sourceDid) {
+                continue;
+            }
+            int seenId = seen.getId();
+            if (seenId > prevReadMaxId && seenId <= maxMid) {
+                countDiff++;
+            }
+        }
+        if (countDiff <= 0) {
+            countDiff = 1;
+        }
+
+        getMessagesController().markDialogAsRead(sourceDid, maxMid, 0, msg.messageOwner.date, false, 0, countDiff, true, 0);
+        // Safemode;
+        feedRequestServerUnread(sourceDid);
+        // Safemode end
+    }
+    // Safemode;
+    feedUpdateUnreadBadge();
+    // Safemode end
+}
