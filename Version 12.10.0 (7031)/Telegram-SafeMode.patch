+private void feedLoadWindow(int folderId, java.util.ArrayList<Long> channelsList, int bMid, int bDate, long bUid, boolean around) {
+    final int olderLimit = around ? FEED_WINDOW_OLDER : FEED_INITIAL_PAGE;
+
+    getMessagesStorage().loadFeedMessages(folderId, channelsList, around ? bMid + 1 : 0, around ? bDate : 0, bUid, olderLimit, olderPart -> {
+        feedMergeAppend(olderPart);
+        final boolean cacheEnded = olderPart.size() < olderLimit;
+        if (!around) {
+            feedHasNewer = false;
+            feedFinishWindow(cacheEnded, false);
+            return;
+        }
+        getMessagesStorage().loadFeedMessages(folderId, channelsList, bMid, bDate, bUid, FEED_WINDOW_NEWER, true, newerPart -> {
+            feedMergeInsert(newerPart);
+
+            feedHasNewer = newerPart.size() >= FEED_WINDOW_NEWER;
+            feedFinishWindow(cacheEnded, true);
+        });
+    });
+}
