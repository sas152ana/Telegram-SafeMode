+private void feedMergeAppend(java.util.ArrayList<MessageObject> loaded) {
+    if (loaded == null || loaded.isEmpty()) {
+        return;
+    }
+    java.util.HashSet<String> seen = new java.util.HashSet<>();
+    for (int i = 0; i < messages.size(); i++) {
+        String key = feedMessageKey(messages.get(i));
+        if (key != null) {
+            seen.add(key);
+        }
+    }
+    for (int i = 0; i < loaded.size(); i++) {
+        MessageObject feedMsg = loaded.get(i);
+        String key = feedMessageKey(feedMsg);
+        if (key != null && !seen.add(key)) {
+            continue;
+        }
+        if (feedMsg.stableId == 0) {
+            feedMsg.stableId = lastStableId++;
+        }
+        messages.add(feedMsg);
+    }
+}
