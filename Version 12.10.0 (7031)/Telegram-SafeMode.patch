+private void feedInitialLoad() {
+    final int folderId = org.telegram.messenger.SecretModeController.getFolderIdFromFeedId(dialog_id);
+    java.util.Set<Long> channelsSet = org.telegram.messenger.SecretModeController.getInstance(currentAccount).getFeedChannelsSynced(folderId);
+    final java.util.ArrayList<Long> channelsList = new java.util.ArrayList<>(channelsSet);
+    loading = true;
+    feedHasNewer = false;
+    feedLoadingNewer = false;
+    if (feedForceNewest) {
+        feedForceNewest = false;
+        feedLoadWindow(folderId, channelsList, 0, 0, 0L, false);
+        return;
+    }
+
+    java.util.ArrayList<Integer> readMaxIds = new java.util.ArrayList<>(channelsList.size());
+    for (int i = 0; i < channelsList.size(); i++) {
+        readMaxIds.add(feedReadMaxId(channelsList.get(i)));
+    }
+    getMessagesStorage().getFeedUnreadBoundary(channelsList, readMaxIds, cursor -> {
+        if (cursor == null || cursor.length < 3 || cursor[0] <= 0) {
+            feedLoadWindow(folderId, channelsList, 0, 0, 0L, false);
+            return;
+        }
+        feedLoadWindow(folderId, channelsList, (int) cursor[1], (int) cursor[0], cursor[2], true);
+    });
