+        org.telegram.messenger.MessagesController mc =
+                org.telegram.messenger.MessagesController.getInstance(profileActivity.getCurrentAccount());
+        java.util.ArrayList<MessagesController.DialogFilter> filters = mc.getDialogFilters();
+        if (filters == null || filters.isEmpty()) {
+            return;
+        }
+        MessagesController.DialogFilter filter = null;
+        for (int i = 0; i < filters.size(); i++) {
+            if (filters.get(i).id == folderId) {
+                filter = filters.get(i);
+                break;
+            }
+        }
+        if (filter == null || filter.alwaysShow == null) {
+            return;
+        }
+        org.telegram.messenger.SecretModeController smc =
+                org.telegram.messenger.SecretModeController.getInstance(profileActivity.getCurrentAccount());
+        java.util.Set<Long> selected = smc.getFeedChannels(folderId);
+        if (selected.isEmpty()) {
+            return;
+        }
+        java.util.Set<Long> kept = new java.util.HashSet<>();
+        boolean changed = false;
+        for (Long did : selected) {
+            boolean inFolder;
+            if (filter.neverShow != null && filter.neverShow.contains(did)) {
+                inFolder = false;
+            } else if (filter.alwaysShow.contains(did)) {
+                inFolder = true;
+            } else {
+                TLRPC.Chat chat = mc.getChat(-did);
+                if (chat == null) {
+                    inFolder = true;
+                } else if (ChatObject.isChannel(chat) && !chat.megagroup) {
+                    inFolder = (filter.flags & MessagesController.DIALOG_FILTER_FLAG_CHANNELS) != 0;
+                } else {
+                    inFolder = (filter.flags & MessagesController.DIALOG_FILTER_FLAG_GROUPS) != 0;
+                }
+            }
+            if (inFolder) {
+                kept.add(did);
+            } else {
+                changed = true;
+            }
+        }
+        if (changed) {
+            smc.setFeedChannelsQuiet(folderId, kept);
+
+            feedScheduleSourcesReload();
+        }
