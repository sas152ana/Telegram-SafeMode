+private void feedRequestServerUnread(long sourceDid) {
+    if (sourceDid >= 0 || org.telegram.messenger.SecretModeController.isVirtualFeed(sourceDid)) {
+        return;
+    }
+    long now = System.currentTimeMillis();
+    Long last = feedUnreadRequested.get(sourceDid);
+    if (last != null && now - last < FEED_UNREAD_REQUEST_INTERVAL_MS) {
+        return;
+    }
+    feedUnreadRequested.put(sourceDid, now);
+    AndroidUtilities.runOnUIThread(() -> {
+        TLRPC.InputPeer inputPeer = getMessagesController().getInputPeer(sourceDid);
+        if (inputPeer == null || (inputPeer instanceof TLRPC.TL_inputPeerChannel && inputPeer.access_hash == 0)) {
+            return;
+        }
+        TLRPC.TL_messages_getPeerDialogs req = new TLRPC.TL_messages_getPeerDialogs();
+        TLRPC.TL_inputDialogPeer inputDialogPeer = new TLRPC.TL_inputDialogPeer();
+        inputDialogPeer.peer = inputPeer;
+        req.peers.add(inputDialogPeer);
+        getConnectionsManager().sendRequest(req, (response, error) -> AndroidUtilities.runOnUIThread(() -> {
+            if (!(response instanceof TLRPC.TL_messages_peerDialogs)) {
+                feedUnreadRequested.remove(sourceDid);
+                return;
+            }
+            TLRPC.TL_messages_peerDialogs res = (TLRPC.TL_messages_peerDialogs) response;
+            for (int a = 0; a < res.dialogs.size(); a++) {
+                TLRPC.Dialog serverDialog = res.dialogs.get(a);
+                if (serverDialog == null || serverDialog.peer == null) {
+                    continue;
+                }
+                org.telegram.messenger.DialogObject.initDialog(serverDialog);
+                if (serverDialog.id != sourceDid) {
+                    continue;
+                }
+
+                if (serverDialog.read_inbox_max_id < feedReadMaxId(sourceDid)) {
+                    feedUnreadRequested.remove(sourceDid);
+                    continue;
+                }
+                LongSparseIntArray inbox = new LongSparseIntArray();
+                LongSparseIntArray stillUnread = new LongSparseIntArray();
+                inbox.put(sourceDid, serverDialog.read_inbox_max_id);
+                stillUnread.put(sourceDid, serverDialog.unread_count);
+                getMessagesStorage().updateDialogsWithReadMessages(inbox, null, null, stillUnread, true);
+            }
+        }));
+    }, FEED_UNREAD_REQUEST_DELAY_MS);
+}
